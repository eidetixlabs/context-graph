FROM python:3.12-slim

WORKDIR /app
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY inference-service/requirements.gliner.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Pre-cache GLiNER model at build time so the container starts without network access.
ARG HF_TOKEN=""
RUN export HF_TOKEN="${HF_TOKEN}" HUGGING_FACE_HUB_TOKEN="${HF_TOKEN}" \
 && python -c "from gliner import GLiNER; GLiNER.from_pretrained('urchade/gliner_medium-v2.1')"

# Prevent runtime download attempts — model is pre-cached above.
ENV HF_HUB_OFFLINE=1

COPY inference-service/gliner_main.py ./main.py

EXPOSE 9111
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9111"]
